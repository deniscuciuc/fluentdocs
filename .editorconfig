root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

[*.{csproj,props,targets,sln,yml,yaml,json,md}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# --- Analyzers -------------------------------------------------------------
[*.cs]
# IDE0160: the codebase uses file-scoped namespaces throughout.
csharp_style_namespace_declarations = file_scoped:warning

# A library must not capture the caller's SynchronizationContext: an app with one
# (WPF, WinForms, legacy ASP.NET) can otherwise deadlock while generating a document.
dotnet_diagnostic.CA2007.severity = warning
# Public entry points validate their arguments rather than surfacing a
# NullReferenceException from deep inside a renderer.
dotnet_diagnostic.CA1062.severity = warning
# Renderers own streams and OpenXML documents; those must be released.
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1063.severity = warning
# Generated output must not depend on the machine's locale: a decimal comma in an XLSX
# cell or a localised date in DOCX front matter is a real, silent corruption.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning

[src/**/*.cs]
# CA1720 flags BorderStyle.Double and AnimationType.Float as "containing a type name".
# Both are the domain's own words — a double-ruled border and a float animation are what
# Word and PowerPoint call them — and renaming them would make the enums harder to map to
# the formats they describe.
dotnet_diagnostic.CA1720.severity = none
# CA1848 wants LoggerMessage source generators. Document generation is measured in
# milliseconds per file, not microseconds per log line — the ceremony is not worth it.
dotnet_diagnostic.CA1848.severity = suggestion
# CA1873 flags log arguments it thinks are expensive to evaluate, but the values it points
# at are already computed for the generation itself.
dotnet_diagnostic.CA1873.severity = suggestion

[{tests,examples}/**/*.cs]
# xUnit method names are Method_Should_When, which CA1707 objects to.
dotnet_diagnostic.CA1707.severity = none
# Top-level programs and test fixtures do not need namespaces.
dotnet_diagnostic.CA1050.severity = none
# Test code is not a shipped API surface.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1711.severity = none
# CA1861 wants inline constant arrays hoisted to static readonly fields. In a test that
# builds its expected values next to the assertion, inlining is the clearer form.
dotnet_diagnostic.CA1861.severity = none
