<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every code sample in README.md and docs/ is reproduced here so that CI fails when a
    documented snippet stops compiling. It is a library, not a test project: compiling is
    the assertion.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentDocs\FluentDocs.csproj" />
  </ItemGroup>

</Project>
